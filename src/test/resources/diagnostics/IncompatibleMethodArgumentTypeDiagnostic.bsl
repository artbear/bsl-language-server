// Параметры:
//  Значение - Число, Строка - значение.
Процедура Вызов(Значение)
КонецПроцедуры

Процедура Проверка(Неизвестно, Условие)
    Вызов(1);
    Вызов("да");
    Вызов(Новый Массив);
    Вызов(Неопределено);
    Аргумент = 1;
    Вызов(Аргумент + "1");
    Вызов(Аргумент);
    Аргумент = Новый Структура;
    Вызов(Аргумент);
    Вызов(Неизвестно);
    Вызов();
    Вызов(Истина, Ложь);
    Если Условие Тогда
        Вариант = Новый Массив;
    Иначе
        Вариант = Неизвестно;
    КонецЕсли;
    Вызов(Вариант);
    Если Условие Тогда
        Вариант = Новый Структура;
    Иначе
        Вариант = Новый Массив;
    КонецЕсли;
    Вызов(Вариант);
    Вызов(?(Условие, Истина, Ложь));
    Вызов(?(Условие, Новый Структура, Неизвестно));
    Вызов(?(Условие, Новый Структура, ""));
    Аргумент = Новый Структура;
    Изменить(Аргумент);
    Вызов(Аргумент);
    Необязательный(Неопределено);
КонецПроцедуры

Процедура Изменить(Аргумент)
    Аргумент = 1;
КонецПроцедуры

