Функция СценарийQ14(Флаг)
    З = Новый Запрос("ВЫБРАТЬ &Ключ КАК Поле");
    Если Флаг Тогда
        З.УстановитьПараметр("Ключ", 1);
    КонецЕсли;
    Если Флаг Тогда
        Р = З.Выполнить();
    Иначе
        Возврат З;
    КонецЕсли;
    Возврат Неопределено;
КонецФункции

